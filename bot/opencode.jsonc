{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "brain",
  "references": {
    "workspace": {
      "path": "..",
      "description": "Parent Cloudtransition workspace. Attach for parent or sibling projects; consult root AGENTS.md and each target project's own instructions. Access is not a grant to modify files."
    }
  },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },

    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },

    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/code/Cloudtransition/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/Volumes/SANDISK USB/work/Cloudtransition/*", "effect": "allow" },

    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "~/code/Cloudtransition/*", "effect": "ask" },
    { "action": "edit", "resource": "~/code/Cloudtransition/bot/*", "effect": "allow" },
    { "action": "edit", "resource": "/Volumes/SANDISK USB/work/Cloudtransition/*", "effect": "ask" },
    { "action": "edit", "resource": "/Volumes/SANDISK USB/work/Cloudtransition/bot/*", "effect": "allow" },

    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "python3 tools/dashboard.py *", "effect": "allow" },
    { "action": "shell", "resource": "python3 */bot/tools/dashboard.py *", "effect": "allow" }
  ]
}
