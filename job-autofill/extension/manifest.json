{
  "manifest_version": 3,
  "name": "AutoFill — job applications",
  "version": "0.1.0",
  "description": "Fills job application forms from a local profile. Nothing is submitted without your say-so.",
  "permissions": ["storage", "unlimitedStorage", "scripting", "activeTab", "debugger", "tabs"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "AutoFill", "default_popup": "popup/popup.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["content/main.js"]
    }
  ]
}
